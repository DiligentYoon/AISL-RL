    <!-- ****************************************** Joint ******************************************************** -->
    
    <joint name="hip_L_Joint" type="fixed">
        <origin xyz="51.079E-03 96.336E-03 -87.088E-03" rpy="0.034906585 0 0"/>
        <parent link="base_Link"/>
        <child link="hip_L_Link"/>
        <!--
        <axis xyz="-1 0 0"/>
        <limit effort="4.5" lower="-1.7453" upper="1.0123" velocity="33.5"/>
        <dynamics damping="0.0" stiffness ="0.0"/>
        <dynamics friction="0.0" />
        -->
    </joint>
    
    <joint name="hip_R_Joint" type="fixed">
        <origin xyz="51.079E-03 -96.336E-03 -87.088E-03" rpy="-0.034906585 0 0"/>
        <parent link="base_Link"/>
        <child link="hip_R_Link"/>
        <!--
        <axis xyz="-1 0 0"/>
        <limit effort="4.5" lower="-1.0123" upper="1.7453" velocity="33.5"/>
        <dynamics damping="0.0" stiffness ="0.0"/>
        <dynamics friction="0.0" />
        -->
    </joint>
    
    <joint name="thigh_L_Joint" type="revolute">
        <origin xyz="-54E-03 -17E-03 0" rpy="0 0 0"/>
        <parent link="hip_L_Link"/>
        <child link="thigh_L_Link"/>
        <axis xyz="0 1 0"/>
        <limit effort="4.5" lower="-0.3840" upper="2.0071" velocity="33.5"/>
        <dynamics damping="0.0" stiffness ="0.0"/>
        <dynamics friction="0.0" />
    </joint>

    <joint name="thigh_R_Joint" type="revolute">
        <origin xyz="-54E-03 17E-03 0" rpy="0 0 0"/>
        <parent link="hip_R_Link"/>
        <child link="thigh_R_Link"/>
        <axis xyz="0 -1 0"/>
        <limit effort="4.5" lower="-2.0071" upper="0.3840" velocity="33.5"/>
        <dynamics damping="0.0" stiffness ="0.0"/>
        <dynamics friction="0.0" />
    </joint>

    <joint name="knee_L_Joint" type="revolute">
        <origin xyz="0 18E-03 -205E-03" rpy="0 0 0"/>
        <parent link="thigh_L_Link"/>
        <child link="calf_L_Link"/>
        <axis xyz="0 -1 0"/>
        <limit effort="9.0" lower="-0.523599" upper="2.3387" velocity="33.5"/>
        <dynamics damping="0.0" stiffness ="0.0"/>
        <dynamics friction="0.0" />
    </joint>

    <joint name="knee_R_Joint" type="revolute">
        <origin xyz="0 -18E-03 -205E-03" rpy="0 0 0"/>
        <parent link="thigh_R_Link"/>
        <child link="calf_R_Link"/>
        <axis xyz="0 1 0"/>
        <limit effort="9.0" lower="-2.3387" upper="0.523599" velocity="33.5"/>
        <dynamics damping="0.0" stiffness ="0.0"/>
        <dynamics friction="0.0" />
    </joint>

    <joint name="wheel_L_Joint" type="revolute">
        <origin xyz="0 16.555E-03 -200E-03" rpy="0 0 0"/>
        <parent link="calf_L_Link" />
        <child link="wheel_L_Link" />
        <axis xyz="0 1 0" />
        <limit effort="2.5" lower="-1000000" upper="1000000" velocity="33.5" />
        <dynamics damping="0.0" stiffness="0.0"/>
        <dynamics friction="0.0" />
    </joint>
    
    <joint name="wheel_R_Joint" type="revolute">
        <origin xyz="0 -16.555E-03 -200E-03" rpy="0 0 0"/>
        <parent link="calf_R_Link" />
        <child link="wheel_R_Link" />
