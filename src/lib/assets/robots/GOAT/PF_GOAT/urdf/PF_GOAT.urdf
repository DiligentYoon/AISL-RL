        </visual>
        <collision>
            <origin xyz="-53.5E-03 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder length="135E-03" radius="42E-03"/>
            </geometry>
        </collision>
    </link>

    <link name="thigh_L_Link">
        <inertial>
            <origin rpy="0 0 0" xyz="-2.015E-03 42.352E-03 -35.272E-03"/>
            <mass value="0.483216"/>
            <inertia ixx="2425E-06" ixy="-20.797926E-06" ixz="-75.779875E-06"
                    iyy="2342E-06" iyz="-378.3E-06" izz="385E-06"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/thigh_L_Link.stl"/>
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="-11E-03 16E-03 -116E-03" rpy="0 0 0"/>
            <geometry>
                <box size="0.09 0.05 0.145"/>
            </geometry>
        </collision>
    </link>

    <link name="thigh_R_Link">
        <inertial>
            <origin rpy="0 0 0" xyz="-2.015E-03 -42.352E-03 -35.272E-03"/>
            <mass value="0.483216"/>
            <inertia ixx="2425E-06" ixy="20.797926E-06" ixz="-75.779875E-06"
                    iyy="2342E-06" iyz="378.3E-06" izz="385E-06"/>
                    
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
