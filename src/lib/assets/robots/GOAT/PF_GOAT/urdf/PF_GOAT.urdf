    <!-- ****************************************** Link ******************************************************** -->

    <link name="base_Link">
        <inertial>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
            <mass value="3.153308"/>
            <inertia ixx="21860E-06" ixy="-11.699458E-06" ixz="6702E-06"
                    iyy="25170E-06" iyz="4.493943E-06" izz="23520E-06"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/base_Link.stl"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 0.8 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="-11E-03 0E-03 56E-03" rpy="0 0 0"/>
            <geometry>
                <box size="0.214 0.200 0.190"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="0.07 0.0 -0.078" rpy="0 0 0"/>
            <geometry>
                <box size="0.07 0.25 0.08"/>
            </geometry>
        </collision>
    </link>

    <link name="hip_L_Link">
        <inertial>
            <origin rpy="0 0 0" xyz="-43.122E-03 -38.397E-03 0.19E-03"/>
            <mass value="0.319"/>
            <inertia ixx="146.6E-06" ixy="-11.4033E-06" ixz="-6.278833E-06"
                    iyy="204.2E-06" iyz="-0.904927E-06" izz="181.8E-06"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/hip_L_Link.stl"/>
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="-53.5E-03 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder length="135E-03" radius="42E-03"/>
            </geometry>
        </collision>
    </link>

    <link name="hip_R_Link">
        <inertial>
            <origin rpy="0 0 0" xyz="-43.122E-03 38.397E-03 0.19E-03"/>
            <mass value="0.319"/>
            <inertia ixx="146.6E-06" ixy="11.4033E-06" ixz="-6.278833E-06"
                    iyy="204.2E-06" iyz="0.904927E-06" izz="181.8E-06"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/hip_R_Link.stl"/>
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 1.0"/>
