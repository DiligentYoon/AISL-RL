            <geometry>
                <box size="0.09 0.05 0.145"/>
            </geometry>
        </collision>
    </link>
    
    <!-- Update required-->
    <link name="calf_L_Link">
        <inertial>
            <origin rpy="0 0 0" xyz="3.619E-03 -0.038E-03 -122.422E-03"/>
            <mass value="0.145"/>
            <inertia ixx="3319.3E-06" ixy="-0.0065456E-06" ixz="51.963E-06"
                iyy="3340.3E-06" iyz="-2.9598E-06" izz="66.810E-06"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/point_calf_L_Link.stl"/>
            </geometry>
            <material name="">
                <color rgba="0.79216 0.81961 0.93333 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -77E-03" rpy="0 0 0"/>
            <geometry>
                <cylinder length="180E-03" radius="30.0E-03"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="0 0 -0.2" rpy="0 0 0"/>
            <geometry>
                <sphere radius="35E-03"/>
            </geometry>
        </collision>
    </link>

    <link name="calf_R_Link">
        <inertial>
            <origin rpy="0 0 0" xyz="3.619E-03 0.038E-03 -122.422E-03"/>
            <mass value="0.145"/>
            <inertia ixx="3319.3E-06" ixy="0.0065456E-06" ixz="51.963E-06"
