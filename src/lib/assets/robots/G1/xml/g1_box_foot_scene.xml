<mujoco model="g1_box_foot_scene">
  <!-- Robot body tree (auto-converted from URDF; do not edit by hand). -->
  <include file="g1_box_foot.xml"/>

  <!-- Match Isaac Lab ImplicitActuatorCfg(armature=0.01) on every actuated joint.
       Without this, light arm/wrist joints (intrinsic rotational inertia ~1e-3 kg·m²)
       become massively over-damped under the same PD gains tuned for I_eff=0.011
       (link inertia + 0.01 rotor inertia) on the Isaac Lab side. -->
  <default>
    <joint armature="0.01"/>
  </default>

  <!-- Sim integration: 5 ms step (200 Hz) matches the outer pacing loop. -->
  <option timestep="0.005" integrator="implicitfast" iterations="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <!--
    Implicit-PD position actuators. Each actuator applies
        τ = kp*(ctrl - q) - kv*qd
    inside MuJoCo; the implicitfast integrator (see <option>) treats the kv*qd
    term implicitly, replicating Isaac Lab's ImplicitActuatorCfg stability.
    Kp/Kd values mirror src/lib/assets/robots/G1/G1_hand/G1_hand.py (stiffness, damping).
    forcerange = min(Isaac effort_limit, URDF joint actuatorfrcrange).
    ctrlrange = URDF joint range; ctrl is interpreted as desired joint position (rad).
  -->
  <actuator>
    <!-- Left leg -->
    <position name="left_hip_pitch_act"   joint="left_hip_pitch_joint"   kp="200" kv="5" forcerange="-88  88"   ctrlrange="-2.5307 2.8798"/>
    <position name="left_hip_roll_act"    joint="left_hip_roll_joint"    kp="150" kv="5" forcerange="-139 139"  ctrlrange="-0.5236 2.9671"/>
    <position name="left_hip_yaw_act"     joint="left_hip_yaw_joint"     kp="150" kv="5" forcerange="-88  88"   ctrlrange="-2.7576 2.7576"/>
    <position name="left_knee_act"        joint="left_knee_joint"        kp="200" kv="5" forcerange="-139 139"  ctrlrange="-0.087267 2.8798"/>
    <position name="left_ankle_pitch_act" joint="left_ankle_pitch_joint" kp="20"  kv="2" forcerange="-20  20"   ctrlrange="-0.87267 0.5236"/>
    <position name="left_ankle_roll_act"  joint="left_ankle_roll_joint"  kp="20"  kv="2" forcerange="-20  20"   ctrlrange="-0.2618 0.2618"/>

    <!-- Right leg -->
    <position name="right_hip_pitch_act"   joint="right_hip_pitch_joint"   kp="200" kv="5" forcerange="-88  88"   ctrlrange="-2.5307 2.8798"/>
    <position name="right_hip_roll_act"    joint="right_hip_roll_joint"    kp="150" kv="5" forcerange="-139 139"  ctrlrange="-2.9671 0.5236"/>
    <position name="right_hip_yaw_act"     joint="right_hip_yaw_joint"     kp="150" kv="5" forcerange="-88  88"   ctrlrange="-2.7576 2.7576"/>
    <position name="right_knee_act"        joint="right_knee_joint"        kp="200" kv="5" forcerange="-139 139"  ctrlrange="-0.087267 2.8798"/>
    <position name="right_ankle_pitch_act" joint="right_ankle_pitch_joint" kp="20"  kv="2" forcerange="-20  20"   ctrlrange="-0.87267 0.5236"/>
    <position name="right_ankle_roll_act"  joint="right_ankle_roll_joint"  kp="20"  kv="2" forcerange="-20  20"   ctrlrange="-0.2618 0.2618"/>

    <!-- Waist -->
    <position name="waist_yaw_act"   joint="waist_yaw_joint"   kp="200" kv="5" forcerange="-88 88" ctrlrange="-2.618 2.618"/>
    <position name="waist_roll_act"  joint="waist_roll_joint"  kp="200" kv="5" forcerange="-35 35" ctrlrange="-0.52 0.52"/>
    <position name="waist_pitch_act" joint="waist_pitch_joint" kp="200" kv="5" forcerange="-35 35" ctrlrange="-0.52 0.52"/>

    <!-- Left arm -->
    <position name="left_shoulder_pitch_act" joint="left_shoulder_pitch_joint" kp="40" kv="10" forcerange="-25 25" ctrlrange="-3.0892 2.6704"/>
    <position name="left_shoulder_roll_act"  joint="left_shoulder_roll_joint"  kp="40" kv="10" forcerange="-25 25" ctrlrange="-1.5882 2.2515"/>
    <position name="left_shoulder_yaw_act"   joint="left_shoulder_yaw_joint"   kp="40" kv="10" forcerange="-25 25" ctrlrange="-2.618 2.618"/>
    <position name="left_elbow_act"          joint="left_elbow_joint"          kp="40" kv="10" forcerange="-25 25" ctrlrange="-1.0472 2.0944"/>
    <position name="left_wrist_roll_act"     joint="left_wrist_roll_joint"     kp="40" kv="10" forcerange="-25 25" ctrlrange="-1.972 1.972"/>
    <position name="left_wrist_pitch_act"    joint="left_wrist_pitch_joint"    kp="40" kv="10" forcerange="-5  5"  ctrlrange="-1.6144 1.6144"/>
    <position name="left_wrist_yaw_act"      joint="left_wrist_yaw_joint"      kp="40" kv="10" forcerange="-5  5"  ctrlrange="-1.6144 1.6144"/>

    <!-- Right arm -->
    <position name="right_shoulder_pitch_act" joint="right_shoulder_pitch_joint" kp="40" kv="10" forcerange="-25 25" ctrlrange="-3.0892 2.6704"/>
    <position name="right_shoulder_roll_act"  joint="right_shoulder_roll_joint"  kp="40" kv="10" forcerange="-25 25" ctrlrange="-2.2515 1.5882"/>
    <position name="right_shoulder_yaw_act"   joint="right_shoulder_yaw_joint"   kp="40" kv="10" forcerange="-25 25" ctrlrange="-2.618 2.618"/>
    <position name="right_elbow_act"          joint="right_elbow_joint"          kp="40" kv="10" forcerange="-25 25" ctrlrange="-1.0472 2.0944"/>
    <position name="right_wrist_roll_act"     joint="right_wrist_roll_joint"     kp="40" kv="10" forcerange="-25 25" ctrlrange="-1.972 1.972"/>
    <position name="right_wrist_pitch_act"    joint="right_wrist_pitch_joint"    kp="40" kv="10" forcerange="-5  5"  ctrlrange="-1.6144 1.6144"/>
    <position name="right_wrist_yaw_act"      joint="right_wrist_yaw_joint"      kp="40" kv="10" forcerange="-5  5"  ctrlrange="-1.6144 1.6144"/>
  </actuator>

  <!--
    Initial standing keyframe (mirrors G1_hand_box_foot.py init_state).
    qpos layout = [px py pz  qw qx qy qz | 29 joints in this order]:
      left leg  (6) : hip_pitch, hip_roll, hip_yaw, knee, ankle_pitch, ankle_roll
      right leg (6) : same
      waist     (3) : yaw, roll, pitch
      left arm  (7) : shoulder_pitch, shoulder_roll, shoulder_yaw, elbow, wrist_roll, wrist_pitch, wrist_yaw
      right arm (7) : same
    Values:
      hip_pitch    = -0.4    (L,R)
      knee         =  0.8    (L,R)
      ankle_pitch  = -0.4    (L,R)
      shoulder_pitch =  0.35 (L,R)
      shoulder_roll  =  0.16 (L) / -0.16 (R)
      elbow        =  0.87   (L,R)
      everything else = 0
  -->
  <keyframe>
    <key name="home"
         qpos="0 0 0.75
               1 0 0 0
               -0.4  0  0  0.8  -0.4  0
               -0.4  0  0  0.8  -0.4  0
                0  0  0
                0.35  0.16  0  0.87  0  0  0
                0.35 -0.16  0  0.87  0  0  0"
         ctrl="-0.4  0  0  0.8  -0.4  0
               -0.4  0  0  0.8  -0.4  0
                0  0  0
                0.35  0.16  0  0.87  0  0  0
                0.35 -0.16  0  0.87  0  0  0"/>
  </keyframe>
</mujoco>
